# ============================================================
# KGK AI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# Never commit the real .env file.
# ============================================================

# --- Model Configuration ---
# Hugging Face model ID for the runtime LLM
MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507
# Fallback model for CPU-only / low-resource environments
MODEL_NAME_FALLBACK=Qwen/Qwen3-0.6B

# --- Generation Parameters ---
MAX_NEW_TOKENS=1024
TEMPERATURE=0.7
TOP_P=0.9
TOP_K=50
REPETITION_PENALTY=1.1

# --- Quantization ---
# Options: none, 4bit, 8bit
QUANTIZATION=4bit

# --- Embedding Model ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- RAG Configuration ---
ENABLE_RAG=true
VECTOR_STORE=faiss
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5
KNOWLEDGE_DIR=knowledge/documents
VECTORSTORE_DIR=knowledge/vectorstore

# --- Memory Configuration ---
ENABLE_MEMORY=true
MEMORY_DIR=data/conversations
LONG_TERM_MEMORY_DIR=data/memory

# --- Tools Configuration ---
ENABLE_TOOLS=true
# Enable sandboxed Python execution (RestrictedPython)
ENABLE_PYTHON_TOOL=true
# Max execution time for Python tool (seconds)
PYTHON_TOOL_TIMEOUT=5

# --- Agents Configuration ---
ENABLE_AGENTS=false

# --- API Configuration ---
API_HOST=0.0.0.0
API_PORT=7860

# --- UI Configuration ---
UI_TITLE=KGK AI
UI_SUBTITLE=AI Intelligence by KGK

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Hugging Face ---
# Only needed for deployment or private model access
# HF_TOKEN=your_huggingface_token_here

# --- Security ---
# Max input length in characters (prompt injection defense)
MAX_INPUT_LENGTH=10000
# Max concurrent requests
MAX_CONCURRENT_REQUESTS=10
